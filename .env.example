# Loopback is the default for a local run.
HOST=127.0.0.1
PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Exact browser origins only if needed. Requests without Origin are permitted.
ALLOWED_ORIGINS=
# Optional MCP bearer token. Protects /mcp ONLY; map and read-only REST remain public.
MCP_TOKEN=
# Optional path to an operator-provided authorised JSON catalogue.
# HOTSPOTS_DATA_PATH=/data/hotspots.json
# HOTSPOTS_METADATA_PATH=/data/metadata.json
