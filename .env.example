# Loopback is the default for a local run.
HOST=127.0.0.1
PORT=3000
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional canonical-host redirect for a renamed public site.
CANONICAL_HOST=
REDIRECT_HOSTS=
# Exact browser origins only if needed. Requests without Origin are permitted.
ALLOWED_ORIGINS=
# Optional MCP bearer token. Protects /mcp ONLY; map and read-only REST remain public.
MCP_TOKEN=
# Optional path to an operator-provided authorised JSON catalogue.
# HOTSPOTS_DATA_PATH=/data/hotspots.json
# HOTSPOTS_METADATA_PATH=/data/metadata.json

# Optional public browser key: restrict to your HTTPS hostname + Maps JavaScript/Places APIs.
# A browser key is visible by design. Never use a server secret here.
GOOGLE_MAPS_BROWSER_KEY=

# Optional public AdSense IDs. Both must be valid to activate the manual ad unit.
# Leave blank to disable ads. Keep Auto ads OFF in the AdSense dashboard.
ADSENSE_CLIENT=
ADSENSE_SLOT=
